      <aspNetCore processPath="dotnet" arguments=".\AgriStreamIoT.dll" stdoutLogEnabled="false" stdoutLogFile="\\?\%home%\LogFiles\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
