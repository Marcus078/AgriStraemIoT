@model AgriStreamIoT.Models.LoginViewModel

@{
    ViewData["Title"] = "Login - AgriStream IoT";
    Layout = "_Layout"; // Or standard _Layout if you prefer
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <div class="card shadow">
            <div class="card-body">
                <h3 class="text-center mb-4">AgriStream Login</h3>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Username" class="form-label"></label>
                        <input asp-for="Username" class="form-control" />
                        <span asp-validation-for="Username" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">Sign In</button>
                    </div>
                </form>

                <div class="mt-3 text-muted small text-center">
                    <p>Default credentials created by seeder:</p>
                    <code>admin / Password123!</code><br />
                    <code>farmer_john / Password123!</code>
                </div>
            </div>
        </div>
    </div>
</div>