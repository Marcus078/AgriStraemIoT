@{
    ViewData["Title"] = "Upload Drone Image - AgriStream";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="mb-3">
        <h2>Upload Aerial Drone Imagery</h2>
        <p class="text-muted">Upload high-resolution farm media. This will trigger the Azure Blob processing pipeline automatically.</p>
    </div>

    <div class="card shadow-sm p-4">
        <form asp-action="UploadDroneImage" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label for="droneImage" class="form-label">Select Image (JPG, PNG)</label>
                <input type="file" class="form-control" id="droneImage" name="droneImage" accept="image/*" required />
            </div>

            <button type="submit" class="btn btn-primary w-100">Upload to Azure Blob Storage</button>
        </form>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary btn-sm">&larr; Back to Dashboard</a>
    </div>
</div>