@model AgriStreamIoT.Models.Device

@{
    ViewData["Title"] = "Delete Device";
}

<div class="container mt-4">
    <h2>Delete Device</h2>
    <h3 class="text-danger">Are you sure you want to delete this device?</h3>
    <hr />

    <div>
        <dl class="row">
            <dt class="col-sm-3">Device ID</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DeviceId)</dd>

            <dt class="col-sm-3">Device Name</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.DeviceName)</dd>

            <dt class="col-sm-3">Location</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Location)</dd>

            <dt class="col-sm-3">Operational Status</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.OperationalStatus)</dd>

            <dt class="col-sm-3">Last Updated</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.LastUpdated)</dd>
        </dl>

        <form asp-action="Delete">
            <input type="hidden" asp-for="DeviceId" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</div>